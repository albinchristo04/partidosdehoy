---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_URL, CLARITY_PROJECT_ID } from '../lib/config';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  schemas?: object[];
  noindex?: boolean;
}

const { title, description, canonical, ogTitle, ogDescription, schemas = [], noindex = false } = Astro.props;

---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  {/* Bing-specific bot directive; Bing also reads the generic robots meta above. */}
  {!noindex && <meta name="bingbot" content="index, follow" />}
  <link rel="canonical" href={canonical} />

  {/* Bing Webmaster meta verification — same code as BingSiteAuth.xml, kept as a
     fallback so verification survives even if the XML file is ever missed. */}
  <meta name="msvalidate.01" content="F01125A32DD0550253E1CD24EAA0B21D" />

  {/* hreflang — the audience spans Spain, Mexico and wider LatAm Spanish. Bing
     weights language/region signals heavily, so we declare es plus the main
     regional variants pointing at the same canonical, with x-default. */}
  <link rel="alternate" hreflang="es" href={canonical} />
  <link rel="alternate" hreflang="es-ES" href={canonical} />
  <link rel="alternate" hreflang="es-MX" href={canonical} />
  <link rel="alternate" hreflang="es-AR" href={canonical} />
  <link rel="alternate" hreflang="es-CO" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:locale:alternate" content="es_MX" />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={ogDescription ?? description} />

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#e63946" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="Pirlo TV — Partidos en Vivo" href="/feed.xml" />

  <!-- Preconnect -->
  <link rel="preconnect" href="https://wc.ppvtv.top" />
  <link rel="dns-prefetch" href="https://wc.ppvtv.top" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

  <!-- Schemas -->
  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  {/* Microsoft Clarity session analytics; is:inline keeps the vendor snippet untouched. */}
  <script is:inline set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window, document, "clarity", "script", "${CLARITY_PROJECT_ID}");`} />
</head>
<body>
  <Nav />
  <main>
    <div class="ad-unit ad-unit-mobile">
      <script is:inline>
        atOptions = {
          'key': '38136bb892ee9912e842b6e4323640e7',
          'format': 'iframe',
          'height': 50,
          'width': 320,
          'params': {}
        };
      </script>
      <script is:inline src="https://czernik.org/22/38136bb892ee9912e842b6e4323640e7"></script>
    </div>
    <slot />
    <div class="ad-unit ad-unit-rectangle">
      <script is:inline>
        atOptions = {
          'key': '36c9aee5e648ca3f7c34a4392d0b310b',
          'format': 'iframe',
          'height': 250,
          'width': 300,
          'params': {}
        };
      </script>
      <script is:inline src="https://czernik.org/22/36c9aee5e648ca3f7c34a4392d0b310b"></script>
    </div>
  </main>
  <Footer />

  <script is:inline data-cfasync="false" src="https://capitalhospitals.org/1/c05f8739758e85600bfeb5f69326d61a"></script>
</body>
</html>

<style>
  .ad-unit {
    margin: 1rem auto;
    max-width: 100%;
    overflow: hidden;
  }
  .ad-unit-mobile {
    width: 320px;
    min-height: 50px;
  }
  .ad-unit-rectangle {
    width: 300px;
    min-height: 250px;
  }
</style>
